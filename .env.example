# REQUIRED
CHESS_USERNAME=your_chesscom_username
CHESS_OUTPUT_DIR=/data
STATE_DB=/data/state.sqlite
STOCKFISH_PATH=/usr/bin/stockfish
ENABLE_ENGINE="true"
ENGINE_DEPTH="15"

# OPTIONAL

# Postgres in docker-compose (auto default if omitted)
DATABASE_URL=postgresql://chess:chess@postgres:5432/chesscoach

# Telegram (optional)
TG_BOT_TOKEN=
TG_CHAT_ID=

# OpenAI (optional)
# OPENAI_API_KEY=

# Ollama (optional)
# In Docker, use host.docker.internal to reach host Ollama.
# If unset (or set to localhost/127.0.0.1 in Docker), the app auto-resolves to http://host.docker.internal:11434.
OLLAMA_URL=http://host.docker.internal:11434 # (or your host ollama IP)
OLLAMA_MODEL=<your ollama model name, e.g. llama3.2:latest>
ENABLE_ENGINE=true
STOCKFISH_PATH=/usr/bin/stockfish
ENGINE_DEPTH=15
PLAYER_SUMMARY_EVERY_N=20
