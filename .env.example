# REQUIRED
CHESS_USERNAME=your_chesscom_username
CHESS_OUTPUT_DIR=/data

# OPTIONAL

# Postgres in docker-compose (auto default if omitted)
DATABASE_URL=postgresql://chess:chess@postgres:5432/chesscoach

# Telegram (optional)
TG_BOT_TOKEN=
TG_CHAT_ID=

# OpenAI (optional)
# OPENAI_API_KEY=

# Ollama (optional)
# In Docker, use host.docker.internal to reach host Ollama.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=<your ollama model name, e.g. llama3.2:latest>
PLAYER_SUMMARY_EVERY_N=20
